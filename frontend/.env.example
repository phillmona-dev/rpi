# Server-side only: where the Next.js BFF reaches the Spring Boot API
RPIS_API_BASE_URL=http://localhost:8080
# Browser-side
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Set to "true" to mark cookies Secure (always true in production)
RPIS_COOKIE_SECURE=false
NEXT_PUBLIC_DEMO_BANNER=true
